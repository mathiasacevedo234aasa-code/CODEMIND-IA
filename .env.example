# Copia este archivo como .env en la raiz del proyecto.
# NUNCA subas .env al repositorio.
#
# Nada de esto es obligatorio: las claves tambien se pueden guardar desde
# Configuracion, y la guardada siempre tiene prioridad sobre lo que haya aqui
# o en las variables del sistema. En la aplicacion instalada no existe .env,
# asi que ahi la unica via es Configuracion.

# --- Servicios de IA. Solo hace falta el del proveedor que vayas a usar.
# Las claves las usa unicamente el backend; nunca se envian al navegador.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Ollama corre en tu propio equipo y no necesita ninguna clave.
# Su direccion se configura desde la interfaz (por omision localhost:11434).

# Modelo por defecto de Groq, por compatibilidad. Desde la version 1.0.0 el
# modelo de cada proveedor se elige y se guarda desde Configuracion.
GROQ_MODEL=openai/gpt-oss-120b

# Puerto del backend
PORT=5174
