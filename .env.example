# Copia este archivo como .env en la raiz del proyecto.
# NUNCA subas .env al repositorio.

# Clave de Groq. Solo la usa el backend; nunca se envia al navegador.
GROQ_API_KEY=

# Modelo por defecto. Se puede cambiar desde la interfaz (Configuracion).
GROQ_MODEL=openai/gpt-oss-120b

# Puerto del backend
PORT=5174
